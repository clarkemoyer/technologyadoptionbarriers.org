{
  "name": "technologyadoptionbarriers-org",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/generate-search-index.ts",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "preview": "npx serve out -l 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qualtrics:mcp:token": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-qualtrics-mcp-token.ps1",
    "qualtrics:mcp:token:force": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-qualtrics-mcp-token.ps1 -Force",
    "qualtrics:mcp:client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-qualtrics-mcp-client.ps1",
    "qualtrics:flow:dump": "tsx scripts/qualtrics-dump-flow.ts",
    "release:notes": "tsx scripts/generate-release-notes.ts",
    "check-links": "linkinator ./out --recurse --config .linkinatorrc.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "husky",
    "validate:data": "tsx scripts/validate-data-schemas.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^5.2.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "lightningcss": "^1.32.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "postcss": "^8.5.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.6.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "linkinator": "^7.6.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "tmp": "^0.2.5",
    "exceljs": {
      "uuid": "^14.0.0"
    },
    "@lhci/cli": {
      "uuid": "^14.0.0"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
