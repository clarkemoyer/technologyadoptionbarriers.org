{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sensitivity-analysis",
  "description": "Sensitivity analysis results across sample definitions. Must contain only aggregate statistics.",
  "type": "object",
  "required": ["samples", "metrics"],
  "additionalProperties": true,
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of sample definitions used in the analysis",
      "items": {
        "type": "object",
        "required": ["key", "label", "n"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "n": { "type": "number", "minimum": 0 }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "description": "Computed metrics across all sample definitions",
      "items": {
        "type": "object",
        "required": ["key", "label", "values"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "values": {
            "type": "object",
            "description": "Sample-key → numeric value mapping",
            "additionalProperties": {
              "type": ["number", "null"]
            }
          }
        }
      }
    }
  }
}
