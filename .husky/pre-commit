#!/bin/sh
# Auto-format code before committing

# Check if there are any staged files
if ! git diff --cached --quiet; then
  echo "🔧 Running prettier to format code..."
  
  # Run prettier on all files (formats entire repository)
  pnpm run format || {
    echo "❌ Failed to run prettier. Please check your installation."
    exit 1
  }

  # Re-stage files that were originally staged
  # Use null-terminated output to handle filenames with spaces/special characters
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add
  if [ $? -ne 0 ]; then
    echo "❌ Failed to re-stage some formatted files. Please run 'git add' manually and retry the commit."
    exit 1
  fi
fi

# Run linting
pnpm run lint || {
  echo "❌ Linting errors detected. Please fix the errors and try again."
  exit 1
}

# PII check: scan staged src/data/**/*.json files for Prolific PID patterns.
# Prolific participant IDs (24-char hex) must never be committed to src/data/.
STAGED_DATA_JSON=$(git diff --cached --name-only --diff-filter=ACMR | grep '^src/data/.*[.]json$' || true)
if [ -n "$STAGED_DATA_JSON" ]; then
  echo "🔍 Checking staged src/data/ files for PII patterns..."
  if command -v python3 >/dev/null 2>&1; then
    # Build argument list safely: one file per line → separate positional args
    set --
    while IFS= read -r f; do
      [ -n "$f" ] && set -- "$@" "$f"
    done <<STAGED_FILES
$STAGED_DATA_JSON
STAGED_FILES
    python3 scripts/check-data-pii.py "$@" || {
      echo "❌ PII patterns detected in staged src/data/ file(s). Remove participant IDs before committing."
      exit 1
    }
  else
    echo "⚠️  python3 not found — skipping PII check. Run 'python3 scripts/check-data-pii.py' manually."
  fi
fi

echo "✅ Pre-commit checks passed."
